// baaki data model.
//
// Money is ALWAYS stored as an integer number of paise (1 rupee = 100 paise).
// Never use floats for money. All monetary columns are `Int` (paise).
//
// "enum" fields are stored as `String` and validated in the application layer
// (see src/lib/constants.ts + zod schemas) rather than as native DB enums, so
// adding/renaming a value is a code change with no schema migration.

// The app runs entirely on the device: this client talks to PGlite (Postgres
// compiled to WebAssembly, stored in the WebView's IndexedDB) through a driver
// adapter, with Prisma's JavaScript query compiler instead of a native engine.
// `npm run db:generate` also patches the output for the browser — see
// scripts/prisma-browser.mjs.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "workerd"
  moduleFormat = "esm"
  engineType   = "client"
}

// Only used when authoring a new migration (`prisma migrate dev` against a
// local Postgres). The app applies prisma/migrations/*.sql to the on-device
// database itself on start-up (src/lib/local-db.ts).
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  // The profile photo as a data: URL (see src/server/api/user/avatar), or null.
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  recurring    RecurringTransaction[]
  tags         Tag[]
  preference   UserPreference?
}

model UserPreference {
  id               String  @id @default(cuid())
  userId           String  @unique
  theme            String  @default("system") // "light" | "dark" | "system"
  currency         String  @default("INR")
  locale           String  @default("en-IN")
  monthStartDay    Int     @default(1) // day of month the financial month begins
  dashboardWidgets String  @default("[]") // JSON array of widget config
  defaultAccountId String?
  appLock          Boolean @default(false) // ask for fingerprint / screen lock on open

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id             String    @id @default(cuid())
  userId         String
  name           String
  type           String    @default("bank") // bank | cash | credit_card | savings | wallet | other
  openingBalance Int       @default(0) // paise
  color          String    @default("#0d9488")
  icon           String    @default("wallet")
  isArchived     Boolean   @default(false)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions     Transaction[] @relation("AccountTransactions")
  transfersIn      Transaction[] @relation("TransferDestination")
  recurring        RecurringTransaction[] @relation("RecurringAccount")
  recurringInbound RecurringTransaction[] @relation("RecurringTransferDestination")
  budgets          BudgetAccount[]
  splitSettlements SplitShare[]  @relation("SplitSettlements")

  // Backstop for the check-then-create race in the accounts API. Names are
  // compared case-insensitively in the app layer; this catches exact-duplicate
  // concurrent creates (e.g. a double-submit) that slip past that check.
  @@unique([userId, name])
  @@index([userId])
}

model Category {
  id           String    @id @default(cuid())
  userId       String
  name         String
  icon         String    @default("tag")
  color        String    @default("#64748b")
  kind         String    @default("expense") // expense | income | both
  monthlyBudget Int?     // default monthly budget in paise (nullable)
  parentId     String?
  isActive     Boolean   @default(true)
  isSystem     Boolean   @default(false)
  // Permanent identity of a built-in category (DefaultCategory.key), kept
  // through renames; null for categories the user created.
  systemKey    String?
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent          Category?        @relation("CategoryChildren", fields: [parentId], references: [id])
  children        Category[]       @relation("CategoryChildren")
  transactions    Transaction[]
  budgetCategories BudgetCategory[]
  recurring       RecurringTransaction[]

  // Backstop for the check-then-create race in the categories API (see the
  // matching note on Account).
  @@unique([userId, name])
  @@unique([userId, systemKey])
  @@index([userId])
  @@index([parentId])
}

model Transaction {
  id                String    @id @default(cuid())
  userId            String
  type              String    // expense | income | transfer
  amount            Int       // paise, always positive
  description       String
  merchant          String?
  date              DateTime
  categoryId        String?
  accountId         String
  transferAccountId String?   // destination account for transfers
  notes             String?
  recurringId       String?   // set when generated from a recurring rule
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime? // soft delete

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category?       @relation(fields: [categoryId], references: [id])
  account         Account         @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  transferAccount Account?        @relation("TransferDestination", fields: [transferAccountId], references: [id])
  recurring       RecurringTransaction? @relation(fields: [recurringId], references: [id])
  tags            TransactionTag[]
  splits          SplitShare[]

  @@index([userId, date])
  @@index([userId, deletedAt])
  @@index([accountId])
  @@index([categoryId])
  @@index([type])
}

// Someone else's part of an expense you paid for: money they owe you back.
// Only your own share (amount − its splits) counts as your spending. Settling
// records the account the money came back into; that raises its balance
// without counting as income.
model SplitShare {
  id               String    @id @default(cuid())
  transactionId    String
  name             String    // who owes it, as typed (no contacts)
  amount           Int       // paise
  settledAt        DateTime?
  settledAccountId String?
  createdAt        DateTime  @default(now())

  transaction    Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  settledAccount Account?    @relation("SplitSettlements", fields: [settledAccountId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([settledAccountId])
}

model Budget {
  id           String   @id @default(cuid())
  userId       String
  year         Int
  month        Int      // 1-12
  overallLimit Int?     // paise; overall monthly cap (nullable)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories BudgetCategory[]
  /// Accounts whose spending counts toward this budget. None = all accounts.
  accounts   BudgetAccount[]

  @@unique([userId, year, month])
  @@index([userId])
}

model BudgetCategory {
  id         String @id @default(cuid())
  budgetId   String
  categoryId String
  limit      Int    // paise

  budget   Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([budgetId, categoryId])
  @@index([categoryId])
}

model BudgetAccount {
  budgetId  String
  accountId String

  budget  Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([budgetId, accountId])
  @@index([accountId])
}

model RecurringTransaction {
  id                String    @id @default(cuid())
  userId            String
  name              String
  type              String    // expense | income | transfer
  amount            Int       // paise
  categoryId        String?
  accountId         String
  transferAccountId String?
  notes             String?
  frequency         String    // daily | weekly | monthly | quarterly | yearly
  interval          Int       @default(1) // every N frequency units
  startDate         DateTime
  endDate           DateTime?
  nextOccurrence    DateTime
  lastPostedDate    DateTime?
  isActive          Boolean   @default(true)
  autoPost          Boolean   @default(false) // if true, occurrences are auto-created when due
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category?     @relation(fields: [categoryId], references: [id])
  account         Account       @relation("RecurringAccount", fields: [accountId], references: [id], onDelete: Cascade)
  transferAccount Account?      @relation("RecurringTransferDestination", fields: [transferAccountId], references: [id])
  transactions    Transaction[]

  @@index([userId])
  @@index([nextOccurrence])
}

model Tag {
  id     String @id @default(cuid())
  userId String
  name   String
  color  String @default("#64748b")

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions TransactionTag[]

  @@unique([userId, name])
  @@index([userId])
}

model TransactionTag {
  transactionId String
  tagId         String

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@index([tagId])
}
