  "scripts": {
    "dev": "npm run generate && next dev",
    "build": "npm run generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate": "prisma generate && node scripts/bundle-migrations.mjs && node scripts/api-routes.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "setup": "npm run generate && prisma migrate deploy",
    "postinstall": "npm run generate"
  },
