<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ launch screen: the logo (launch_logo.xml) arriving as the
     launch video's opening did: the tile pops in, its ink shadow drops, the "b"
     rises into it and the two wedges swing into its bowl. 850ms; the theme's
     windowSplashScreenAnimationDuration matches. Ends exactly on
     launch_logo.xml, which the app takes over from. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/launch_logo">
    <target android:name="pop">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:duration="850">
                    <propertyValuesHolder android:propertyName="scaleX" android:valueType="floatType">
                        <keyframe android:fraction="0" android:value="0" />
                        <keyframe android:fraction="0.5294" android:value="1" android:interpolator="@android:interpolator/overshoot" />
                        <keyframe android:fraction="1" android:value="1" android:interpolator="@android:interpolator/linear" />
                    </propertyValuesHolder>
                </objectAnimator>
                <objectAnimator android:duration="850">
                    <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                        <keyframe android:fraction="0" android:value="0" />
                        <keyframe android:fraction="0.5294" android:value="1" android:interpolator="@android:interpolator/overshoot" />
                        <keyframe android:fraction="1" android:value="1" android:interpolator="@android:interpolator/linear" />
                    </propertyValuesHolder>
                </objectAnimator>
            </set>
        </aapt:attr>
    </target>
    <target android:name="shadow">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:duration="850">
                    <propertyValuesHolder android:propertyName="translateX" android:valueType="floatType">
                        <keyframe android:fraction="0" android:value="-12" />
                        <keyframe android:fraction="0.2941" android:value="-12" android:interpolator="@android:interpolator/linear" />
                        <keyframe android:fraction="0.5882" android:value="0" android:interpolator="@android:interpolator/fast_out_slow_in" />
                        <keyframe android:fraction="1" android:value="0" android:interpolator="@android:interpolator/linear" />
                    </propertyValuesHolder>
                </objectAnimator>
                <objectAnimator android:duration="850">
                    <propertyValuesHolder android:propertyName="translateY" android:valueType="floatType">
                        <keyframe android:fraction="0" android:value="-12" />
                        <keyframe android:fraction="0.2941" android:value="-12" android:interpolator="@android:interpolator/linear" />
                        <keyframe android:fraction="0.5882" android:value="0" android:interpolator="@android:interpolator/fast_out_slow_in" />
                        <keyframe android:fraction="1" android:value="0" android:interpolator="@android:interpolator/linear" />
                    </propertyValuesHolder>
                </objectAnimator>
            </set>
        </aapt:attr>
    </target>
    <target android:name="b">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:duration="850">
                    <propertyValuesHolder android:propertyName="translateY" android:valueType="floatType">
                        <keyframe android:fraction="0" android:value="700" />
                        <keyframe android:fraction="0.1176" android:value="700" android:interpolator="@android:interpolator/linear" />
                        <keyframe android:fraction="0.7059" android:value="0" android:interpolator="@android:interpolator/decelerate_cubic" />
                        <keyframe android:fraction="1" android:value="0" android:interpolator="@android:interpolator/linear" />
                    </propertyValuesHolder>
                </objectAnimator>
            </set>
        </aapt:attr>
    </target>
    <target android:name="b_path">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:duration="850">
                    <propertyValuesHolder android:propertyName="fillAlpha" android:valueType="floatType">
                        <keyframe android:fraction="0" android:value="0" />
                        <keyframe android:fraction="0.1176" android:value="0" android:interpolator="@android:interpolator/linear" />
                        <keyframe android:fraction="0.2941" android:value="1" android:interpolator="@android:interpolator/linear" />
                        <keyframe android:fraction="1" android:value="1" android:interpolator="@android:interpolator/linear" />
                    </propertyValuesHolder>
                </objectAnimator>
            </set>
        </aapt:attr>
    </target>
    <target android:name="tan">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:duration="850">
                    <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                        <keyframe android:fraction="0" android:value="-140" />
                        <keyframe android:fraction="0.4118" android:value="-140" android:interpolator="@android:interpolator/linear" />
                        <keyframe android:fraction="0.8824" android:value="0" android:interpolator="@android:interpolator/overshoot" />
                        <keyframe android:fraction="1" android:value="0" android:interpolator="@android:interpolator/linear" />
                    </propertyValuesHolder>
                </objectAnimator>
            </set>
        </aapt:attr>
    </target>
    <target android:name="tan_path">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:duration="850">
                    <propertyValuesHolder android:propertyName="fillAlpha" android:valueType="floatType">
                        <keyframe android:fraction="0" android:value="0" />
                        <keyframe android:fraction="0.4118" android:value="0" android:interpolator="@android:interpolator/linear" />
                        <keyframe android:fraction="0.5294" android:value="1" android:interpolator="@android:interpolator/linear" />
                        <keyframe android:fraction="1" android:value="1" android:interpolator="@android:interpolator/linear" />
                    </propertyValuesHolder>
                </objectAnimator>
            </set>
        </aapt:attr>
    </target>
    <target android:name="dark">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:duration="850">
                    <propertyValuesHolder android:propertyName="rotation" android:valueType="floatType">
                        <keyframe android:fraction="0" android:value="-160" />
                        <keyframe android:fraction="0.5294" android:value="-160" android:interpolator="@android:interpolator/linear" />
                        <keyframe android:fraction="1.0" android:value="0" android:interpolator="@android:interpolator/overshoot" />
                    </propertyValuesHolder>
                </objectAnimator>
            </set>
        </aapt:attr>
    </target>
    <target android:name="dark_path">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:duration="850">
                    <propertyValuesHolder android:propertyName="fillAlpha" android:valueType="floatType">
                        <keyframe android:fraction="0" android:value="0" />
                        <keyframe android:fraction="0.5294" android:value="0" android:interpolator="@android:interpolator/linear" />
                        <keyframe android:fraction="0.6471" android:value="1" android:interpolator="@android:interpolator/linear" />
                        <keyframe android:fraction="1" android:value="1" android:interpolator="@android:interpolator/linear" />
                    </propertyValuesHolder>
                </objectAnimator>
            </set>
        </aapt:attr>
    </target>
</animated-vector>
